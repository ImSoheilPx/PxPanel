#!/sbin/openrc-run

command="/usr/local/pxpanel/pxpanel"
command_background=true
pidfile="/run/pxpanel.pid"
description="PxPanel Service"
procname="pxpanel"
depend() {
    need net
}
start_pre(){
    cd /usr/local/pxpanel
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1 $(cat $pidfile)
  eend $?
}